{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Design Tokens",
  "type": "object",
  "required": [
    "schema_version",
    "colors",
    "color_contract",
    "typography",
    "spacing",
    "radius"
  ],
  "properties": {
    "schema_version": { "const": "design-tokens/v1" },
    "colors": { "type": "object" },
    "color_contract": { "type": "object" },
    "typography": { "type": "object" },
    "spacing": { "type": "object" },
    "radius": { "type": "object" }
  }
}
