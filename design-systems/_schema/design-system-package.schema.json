{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Design System Package",
  "type": "object",
  "required": ["schema_version", "id", "name", "files", "preview", "contracts"],
  "properties": {
    "schema_version": { "const": "design-system-package/v1" },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "files": {
      "type": "object",
      "required": ["design", "tokens", "components", "components_manifest"],
      "properties": {
        "design": { "type": "string", "minLength": 1 },
        "tokens": { "type": "string", "minLength": 1 },
        "design_tokens": { "type": "string", "minLength": 1 },
        "components": { "type": "string", "minLength": 1 },
        "components_manifest": { "type": "string", "minLength": 1 },
        "icon_sprite": { "type": "string", "minLength": 1 }
      }
    },
    "visual_assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/visual_asset" }
    },
    "preview": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "role"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 }
        }
      }
    },
    "contracts": {
      "type": "object",
      "required": [
        "layout_lock",
        "accent_policy",
        "color_policy",
        "svg_text_policy",
        "motion_policy"
      ],
      "properties": {
        "layout_lock": { "type": "string", "minLength": 1 },
        "accent_policy": { "type": "string", "minLength": 1 },
        "color_policy": { "type": "string", "minLength": 1 },
        "svg_text_policy": { "type": "string", "minLength": 1 },
        "motion_policy": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "visual_asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "family",
        "source",
        "source_url",
        "project",
        "author",
        "license",
        "license_url",
        "license_evidence_ref",
        "retrieved_at",
        "file",
        "sha256",
        "icons"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "const": "icon-set" },
        "family": { "type": "string", "minLength": 1 },
        "source": { "const": "iconfont-local-svg" },
        "source_url": {
          "type": "string",
          "pattern": "^https://www\\.iconfont\\.cn/"
        },
        "project": { "type": "string", "minLength": 1 },
        "author": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "license_url": { "type": "string", "pattern": "^https://" },
        "license_evidence_ref": { "type": "string", "minLength": 1 },
        "retrieved_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "file": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "icons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "source_id"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "source_id": { "type": "string", "pattern": "^\\d+$" }
            }
          }
        }
      }
    }
  }
}
