{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Components Manifest",
  "type": "object",
  "required": ["schema_version", "system_id", "components"],
  "properties": {
    "schema_version": { "const": "components-manifest/v1" },
    "system_id": { "type": "string", "minLength": 1 },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "role", "selectors"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "selectors": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
