{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Design Summary Map",
  "type": "object",
  "required": ["schema_version", "plain_language", "summaries"],
  "properties": {
    "schema_version": { "const": "design-summary-map/v1" },
    "plain_language": {
      "type": "object",
      "required": ["status", "rules"],
      "properties": {
        "status": { "enum": ["manual_reviewed", "not_checked", "not_applicable"] },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "notes": { "type": "string" }
      }
    },
    "summaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "summary_text", "status", "source_refs", "source_quotes", "preserved_numbers"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "summary_text": { "type": "string", "minLength": 1 },
          "status": { "enum": ["verified", "manual_reviewed", "unverified"] },
          "value_origin": {
            "enum": ["source_verbatim", "code_derived", "no_numeric_value"]
          },
          "derivation_refs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "derived_values": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["token", "json_pointer", "derivation_ref"],
              "properties": {
                "token": { "type": "string", "minLength": 1 },
                "json_pointer": { "type": "string", "pattern": "^/" },
                "derivation_ref": { "type": "string", "minLength": 1 }
              }
            }
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "source_quotes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["source_ref", "quote"],
              "properties": {
                "source_ref": { "type": "string", "minLength": 1 },
                "quote": { "type": "string", "minLength": 1 }
              }
            }
          },
          "preserved_numbers": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "value_origin": { "const": "code_derived" } },
              "required": ["value_origin"]
            },
            "then": { "required": ["derivation_refs", "derived_values"] }
          }
        ]
      }
    }
  }
}
