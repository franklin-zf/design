{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Design Deck Plan",
  "type": "object",
  "required": ["slides"],
  "properties": {
    "schema_version": { "const": "design-slide-plan/v1" },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slide", "layout_id", "purpose", "theme", "source", "media_decision"],
        "properties": {
          "slide": { "type": "integer", "minimum": 1 },
          "layout_id": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "theme": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "media_decision": {
            "enum": ["none", "image", "screenshot", "mermaid", "chart", "icon", "generated-schematic", "flowchart", "mind-map"]
          },
          "image_slot": { "type": "string" },
          "image_slots": { "type": "array" },
          "asset_id": { "type": "string" },
          "visual_weight": {
            "enum": ["cover", "statement", "text", "evidence", "image-hero", "diagram", "comparison", "metric", "breath", "close"]
          },
          "slot_contract": {
            "type": "object",
            "required": ["slot", "aspect_ratio"],
            "properties": {
              "slot": { "type": "string", "minLength": 1 },
              "aspect_ratio": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
