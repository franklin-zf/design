{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/design/render-spec.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "resolved_plan_digest", "artifact_digest", "viewports", "segments", "states", "remote_policy", "spec_digest"],
  "properties": {
    "schema_version": { "const": "design-render-spec/v2" },
    "resolved_plan_digest": { "$ref": "#/$defs/sha256" },
    "artifact_digest": { "$ref": "#/$defs/sha256" },
    "viewports": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "enum": [1440, 390, 320] } },
    "segments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/segment" } },
    "states": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/state" } },
    "remote_policy": {
      "type": "object", "additionalProperties": false, "required": ["mode", "allowed_origins"],
      "properties": {
        "mode": { "enum": ["deny_all", "allowlist"] },
        "allowed_origins": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^https?://" } }
      }
    },
    "spec_digest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "segment": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["selector", "scroll_fraction"] },
        "selector": { "type": "string", "minLength": 1 },
        "fraction": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "state": {
      "type": "object", "additionalProperties": false, "required": ["id", "setup", "assertions"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "setup": { "type": "array", "items": { "type": "object" } },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/assertion" }
        }
      }
    },
    "assertion": {
      "oneOf": [
        { "$ref": "#/$defs/visibility_assertion" },
        { "$ref": "#/$defs/text_assertion" },
        { "$ref": "#/$defs/attribute_assertion" },
        { "$ref": "#/$defs/count_assertion" },
        { "$ref": "#/$defs/relation_assertion" },
        { "$ref": "#/$defs/locale_assertion" },
        { "$ref": "#/$defs/icon_assertion" }
      ]
    },
    "visibility_assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "selector"],
      "properties": {
        "kind": { "enum": ["visible", "hidden"] },
        "selector": { "type": "string", "minLength": 1 }
      }
    },
    "text_assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "selector", "expected"],
      "properties": {
        "kind": { "const": "text" },
        "selector": { "type": "string", "minLength": 1 },
        "expected": { "type": "string" }
      }
    },
    "attribute_assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "selector", "attribute", "expected"],
      "properties": {
        "kind": { "const": "attribute" },
        "selector": { "type": "string", "minLength": 1 },
        "attribute": { "type": "string", "minLength": 1 },
        "expected": { "type": "string" }
      }
    },
    "count_assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "selector", "expected"],
      "properties": {
        "kind": { "const": "count" },
        "selector": { "type": "string", "minLength": 1 },
        "expected": { "type": "integer", "minimum": 0 }
      }
    },
    "relation_assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "selector",
        "target_selector",
        "relation",
        "tolerance_px"
      ],
      "properties": {
        "kind": { "const": "relation" },
        "selector": { "type": "string", "minLength": 1 },
        "target_selector": { "type": "string", "minLength": 1 },
        "relation": {
          "enum": [
            "left-edge",
            "right-edge",
            "top-edge",
            "bottom-edge",
            "center-x",
            "center-y",
            "equal-width",
            "equal-height",
            "text-baseline"
          ]
        },
        "tolerance_px": {
          "type": "number",
          "minimum": 0,
          "maximum": 8
        }
      }
    },
    "locale_assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "selector", "locale", "exempt_selector"],
      "properties": {
        "kind": { "const": "locale" },
        "selector": { "type": "string", "minLength": 1 },
        "locale": { "const": "zh-CN" },
        "exempt_selector": { "type": "string", "minLength": 1 },
        "allowed_terms": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "icon_assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "selector",
        "family",
        "asset_ref",
        "provenance_ref",
        "sizes_px",
        "box_selector",
        "box_px",
        "tolerance_px",
        "fallback"
      ],
      "properties": {
        "kind": { "const": "icon" },
        "selector": { "type": "string", "minLength": 1 },
        "family": { "type": "string", "minLength": 1 },
        "asset_ref": { "type": "string", "minLength": 1 },
        "provenance_ref": { "type": "string", "minLength": 1 },
        "sizes_px": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 12,
            "maximum": 24
          }
        },
        "box_selector": { "type": "string", "minLength": 1 },
        "box_px": {
          "type": "integer",
          "minimum": 16,
          "maximum": 32
        },
        "tolerance_px": {
          "type": "number",
          "minimum": 0,
          "maximum": 4
        },
        "fallback": { "const": "visible-label" }
      }
    }
  }
}
