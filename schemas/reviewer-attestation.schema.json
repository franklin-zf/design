{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/design/reviewer-attestation.schema.json",
  "title": "Design host reviewer attestation v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reviewer_id",
    "artifact_author_id",
    "reviewed_at",
    "review_status",
    "artifact_digest",
    "content_digest",
    "surface_digest",
    "machine_attestation_sha256",
    "resolved_plan_digest",
    "reviewer_registry_sha256",
    "host_assertions",
    "checks",
    "findings",
    "remaining_risks",
    "non_claims"
  ],
  "properties": {
    "schema_version": { "const": "design-reviewer-attestation/v2" },
    "reviewer_id": { "type": "string", "minLength": 1 },
    "artifact_author_id": { "type": "string", "minLength": 1 },
    "reviewed_at": { "type": "string", "minLength": 1 },
    "review_status": { "enum": ["approved", "changes_required"] },
    "artifact_digest": { "$ref": "#/$defs/sha256" },
    "content_digest": { "$ref": "#/$defs/sha256" },
    "surface_digest": { "$ref": "#/$defs/sha256" },
    "machine_attestation_sha256": { "$ref": "#/$defs/sha256" },
    "resolved_plan_digest": { "$ref": "#/$defs/sha256" },
    "reviewer_registry_sha256": { "$ref": "#/$defs/sha256" },
    "host_assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["independent", "did_not_author_artifact"],
      "properties": {
        "independent": { "const": true },
        "did_not_author_artifact": { "const": true }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence_refs"],
        "properties": {
          "id": {
            "enum": [
              "source-identity",
              "claim-semantics",
              "numeric-semantics",
              "accessibility",
              "privacy",
              "render",
              "visual-review"
            ]
          },
          "status": { "enum": ["passed", "failed", "not_checked"] },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "status", "summary", "evidence_refs"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["blocking", "major", "minor"] },
          "status": { "enum": ["open", "resolved", "waived_by_user"] },
          "summary": { "type": "string", "minLength": 1 },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "remaining_risks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "non_claims": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
