{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Design Deck Plan",
  "type": "object",
  "required": ["slides"],
  "properties": {
    "schema_version": { "const": "design-slide-plan/v1" },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slide", "layout_id", "purpose", "theme", "source"],
        "properties": {
          "slide": { "type": "integer", "minimum": 1 },
          "layout_id": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "theme": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "media_decision": {
            "enum": ["none", "image", "screenshot", "mermaid", "chart", "icon", "generated-schematic", "flowchart", "mind-map"]
          },
          "image_slot": { "type": "string" },
          "image_slots": { "type": "array" }
        }
      }
    }
  }
}
