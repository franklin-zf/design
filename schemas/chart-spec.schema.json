{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Design Chart Spec",
  "type": "object",
  "required": ["question", "takeaway", "chart_family", "fields", "grain", "unit", "source_ref", "sample_size", "visual_encoding"],
  "properties": {
    "question": { "type": "string", "minLength": 1 },
    "takeaway": { "type": "string", "minLength": 1 },
    "chart_family": {
      "enum": ["scorecard", "trend", "comparison", "composition", "distribution", "relationship", "matrix", "decomposition", "progression", "table"]
    },
    "fields": { "type": "array", "minItems": 1 },
    "grain": { "type": "string", "minLength": 1 },
    "unit": { "type": "string", "minLength": 1 },
    "denominator": { "type": "string" },
    "time_window": { "type": "string" },
    "source_ref": { "type": "string", "minLength": 1 },
    "sample_size": { "type": "number", "minimum": 1 },
    "visual_encoding": {
      "type": "object",
      "required": ["mark", "x", "y", "scale_type", "baseline", "domain", "label_policy"],
      "properties": {
        "mark": { "type": "string", "minLength": 1 },
        "x": { "type": "string", "minLength": 1 },
        "y": { "type": "string", "minLength": 1 },
        "scale_type": { "type": "string", "minLength": 1 },
        "baseline": { "type": "string", "minLength": 1 },
        "domain": { "type": "string", "minLength": 1 },
        "label_policy": { "type": "string", "minLength": 1 }
      }
    },
    "fallback_if_sparse": { "type": "string" }
  }
}
