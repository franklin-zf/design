{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/design/component-catalogue.schema.json",
  "title": "Design component catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalogue_policy",
    "components"
  ],
  "properties": {
    "schema_version": {
      "const": "design-component-catalogue/v1"
    },
    "catalogue_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_decision",
        "control_plane_authority",
        "third_party_source_included",
        "runtime_dependencies_allowed",
        "runtime_network_allowed"
      ],
      "properties": {
        "default_decision": {
          "const": "deny"
        },
        "control_plane_authority": {
          "const": "template-compiler-runner-evidence"
        },
        "third_party_source_included": {
          "const": false
        },
        "runtime_dependencies_allowed": {
          "const": false
        },
        "runtime_network_allowed": {
          "const": false
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+"
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "decision",
        "ownership",
        "technical_class",
        "provenance",
        "license",
        "semantics",
        "implementation",
        "compatibility",
        "fallback",
        "accessibility",
        "performance",
        "required_gate_ids",
        "evidence_refs",
        "limitations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "enum": [
            "admitted",
            "inspiration_only",
            "blocked",
            "project_local"
          ]
        },
        "ownership": {
          "enum": [
            "design_owned",
            "third_party_reference"
          ]
        },
        "technical_class": {
          "enum": [
            "html_css",
            "static_snapshot",
            "native_react"
          ]
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "license": {
          "$ref": "#/$defs/license"
        },
        "semantics": {
          "$ref": "#/$defs/semantics"
        },
        "implementation": {
          "$ref": "#/$defs/implementation"
        },
        "compatibility": {
          "$ref": "#/$defs/compatibility"
        },
        "fallback": {
          "$ref": "#/$defs/fallback"
        },
        "accessibility": {
          "$ref": "#/$defs/accessibility"
        },
        "performance": {
          "$ref": "#/$defs/performance"
        },
        "required_gate_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_kind",
        "source_ref",
        "author",
        "retrieved_at",
        "hash_status"
      ],
      "properties": {
        "source_kind": {
          "enum": [
            "design_owned",
            "third_party_reference"
          ]
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "retrieved_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "hash_status": {
          "enum": [
            "verified",
            "unknown"
          ]
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "id",
        "scope",
        "redistribution",
        "notice_requirement",
        "evidence_ref"
      ],
      "properties": {
        "status": {
          "enum": [
            "known",
            "unknown",
            "conflicted"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "redistribution": {
          "enum": [
            "allowed",
            "forbidden",
            "not_applicable",
            "unknown"
          ]
        },
        "notice_requirement": {
          "enum": [
            "required",
            "not_required",
            "unknown"
          ]
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_job",
        "reader_value",
        "expression_level"
      ],
      "properties": {
        "semantic_job": {
          "enum": [
            "state",
            "direction",
            "sequence",
            "rhythm",
            "evidence_emphasis",
            "action_feedback"
          ]
        },
        "reader_value": {
          "type": "string",
          "minLength": 1
        },
        "expression_level": {
          "enum": [
            "L0-static",
            "L1-interactive",
            "L2-motion"
          ]
        }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_code_included",
        "runtime_dependencies",
        "remote_origins",
        "adapter_id",
        "materialized_files"
      ],
      "properties": {
        "source_code_included": {
          "type": "boolean"
        },
        "runtime_dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "remote_origins": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "adapter_id": {
          "enum": [
            "html_css",
            "static_snapshot",
            "native_react"
          ]
        },
        "materialized_files": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relative_path"
          }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_types",
        "template_ids"
      ],
      "properties": {
        "artifact_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "template_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "fallback_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "description"
      ],
      "properties": {
        "status": {
          "enum": [
            "required",
            "not_applicable",
            "unknown"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "static_html",
        "reduced_motion",
        "ppt_handoff"
      ],
      "properties": {
        "static_html": {
          "$ref": "#/$defs/fallback_state"
        },
        "reduced_motion": {
          "$ref": "#/$defs/fallback_state"
        },
        "ppt_handoff": {
          "$ref": "#/$defs/fallback_state"
        }
      }
    },
    "check_status": {
      "enum": [
        "required",
        "not_applicable",
        "unknown",
        "failed"
      ]
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyboard",
        "focus_visible",
        "accessible_name",
        "screen_reader",
        "contrast",
        "reduced_motion"
      ],
      "properties": {
        "keyboard": {
          "$ref": "#/$defs/check_status"
        },
        "focus_visible": {
          "$ref": "#/$defs/check_status"
        },
        "accessible_name": {
          "$ref": "#/$defs/check_status"
        },
        "screen_reader": {
          "$ref": "#/$defs/check_status"
        },
        "contrast": {
          "$ref": "#/$defs/check_status"
        },
        "reduced_motion": {
          "$ref": "#/$defs/check_status"
        }
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "bounded",
            "unknown",
            "failed"
          ]
        },
        "max_js_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "max_css_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "max_asset_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "max_dom_nodes": {
          "type": "integer",
          "minimum": 0
        },
        "max_continuous_loops": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
