{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/design/reviewer-record.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "reviewer_id", "artifact_author_id", "reviewer_role", "reviewed_at", "review_scope", "review_status", "artifact_digest", "content_digest", "surface_digest", "resolved_plan_digest", "checks", "findings", "remaining_risks", "non_claims"],
  "properties": {
    "schema_version": { "const": "design-reviewer-record/v3" },
    "reviewer_id": { "type": "string", "minLength": 1 },
    "artifact_author_id": { "type": "string", "minLength": 1 },
    "reviewer_role": { "enum": ["independent-reviewer", "quality-risk-auditor"] },
    "reviewed_at": { "type": "string", "minLength": 20 },
    "review_scope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "review_status": { "enum": ["approved", "changes_required", "blocked"] },
    "artifact_digest": { "$ref": "#/$defs/sha256" },
    "content_digest": { "$ref": "#/$defs/sha256" },
    "surface_digest": { "$ref": "#/$defs/sha256" },
    "resolved_plan_digest": { "$ref": "#/$defs/sha256" },
    "checks": { "type": "array", "minItems": 7, "items": { "$ref": "#/$defs/check" } },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "remaining_risks": { "type": "array", "items": { "type": "string" } },
    "non_claims": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "check": {
      "type": "object", "additionalProperties": false, "required": ["id", "status", "evidence_refs"],
      "properties": {
        "id": { "enum": ["source-identity", "claim-semantics", "numeric-semantics", "accessibility", "privacy", "render", "visual-review"] },
        "status": { "enum": ["passed", "failed", "not_checked"] },
        "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "severity", "status", "summary", "evidence_refs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["minor", "major", "blocking"] },
        "status": { "enum": ["open", "resolved"] },
        "summary": { "type": "string", "minLength": 1 },
        "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
