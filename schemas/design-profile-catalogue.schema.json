{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Design Profile Catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product_presets",
    "surface_contracts",
    "topology_patterns",
    "routing",
    "content_routing"
  ],
  "properties": {
    "schema_version": { "const": "design-profile-catalogue/v1" },
    "product_presets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/product_preset" }
    },
    "surface_contracts": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/surface_contract" }
    },
    "interface_policy": { "$ref": "#/$defs/interface_policy" },
    "topology_patterns": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "$ref": "#/$defs/topology_pattern" }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reader_job_to_preset",
        "relationship_to_topology",
        "relationship_to_secondary_preset",
        "secondary_inheritance_fields",
        "secondary_override_policy"
      ],
      "properties": {
        "reader_job_to_preset": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/product_preset_id" }
        },
        "relationship_to_topology": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/topology_id" }
        },
        "relationship_to_secondary_preset": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/product_preset_id" }
        },
        "secondary_inheritance_fields": {
          "const": ["topology", "surface_emphasis"]
        },
        "secondary_override_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "allowed_precedence", "allowed_contributions", "mutually_exclusive_profile_pairs"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "allowed_precedence": {
              "const": ["primary-over-secondary"]
            },
            "allowed_contributions": {
              "const": ["topology", "surface_emphasis"]
            },
            "mutually_exclusive_profile_pairs": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/product_preset_id" }
              }
            }
          }
        }
      }
    },
    "content_routing": { "$ref": "#/$defs/content_routing" }
  },
  "$defs": {
    "interface_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "reference",
        "applies_to_surface_ids",
        "rule_levels",
        "shape",
        "spacing",
        "hierarchy",
        "typography",
        "targets",
        "responsive",
        "focus",
        "dialog",
        "table",
        "icons",
        "feedback"
      ],
      "properties": {
        "schema_version": {
          "enum": ["web-interface-policy/v1", "web-interface-policy/v2"]
        },
        "reference": { "const": "references/web-interface-standards.md" },
        "applies_to_surface_ids": { "const": ["html", "dashboard"] },
        "rule_levels": {
          "const": ["hard_floor", "product_default", "contextual_advisory"]
        },
        "shape": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "level",
            "radius_scale_px",
            "dense_surface_max_radius_px",
            "universal_rounding",
            "pill_roles",
            "nested_radius_policy",
            "large_radius_policy"
          ],
          "properties": {
            "level": { "const": "contextual_advisory" },
            "radius_scale_px": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": { "type": "integer", "minimum": 0, "maximum": 32 }
            },
            "dense_surface_max_radius_px": {
              "type": "integer",
              "minimum": 0,
              "maximum": 12
            },
            "universal_rounding": { "const": false },
            "pill_roles": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["avatar", "status", "tag", "toggle"] }
            },
            "nested_radius_policy": { "type": "string", "minLength": 1 },
            "large_radius_policy": { "type": "string", "minLength": 1 }
          }
        },
        "spacing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "level",
            "token_scale_required",
            "group_gap_greater_than_internal_gap",
            "arbitrary_values_allowed",
            "white_space_policy"
          ],
          "properties": {
            "level": { "const": "product_default" },
            "token_scale_required": { "const": true },
            "group_gap_greater_than_internal_gap": { "const": true },
            "arbitrary_values_allowed": { "const": false },
            "white_space_policy": { "type": "string", "minLength": 1 }
          }
        },
        "hierarchy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "level",
            "max_prominent_actions_per_task",
            "primary_task_first",
            "status_recovery_next_action_visible"
          ],
          "properties": {
            "level": { "const": "product_default" },
            "max_prominent_actions_per_task": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2
            },
            "primary_task_first": { "const": true },
            "status_recovery_next_action_visible": { "const": true }
          }
        },
        "typography": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "size_level",
            "contrast_level",
            "adaptation_level",
            "essential_text_min_css_px",
            "supporting_text_min_css_px",
            "metadata_text_min_css_px",
            "normal_text_contrast_ratio",
            "large_text_contrast_ratio",
            "non_text_contrast_ratio",
            "viewport_width_font_scaling",
            "text_spacing_override_required"
          ],
          "properties": {
            "size_level": { "const": "product_default" },
            "contrast_level": { "const": "hard_floor" },
            "adaptation_level": { "const": "hard_floor" },
            "essential_text_min_css_px": {
              "type": "integer",
              "minimum": 16,
              "maximum": 24
            },
            "supporting_text_min_css_px": {
              "type": "integer",
              "minimum": 14,
              "maximum": 20
            },
            "metadata_text_min_css_px": {
              "type": "integer",
              "minimum": 12,
              "maximum": 18
            },
            "normal_text_contrast_ratio": { "const": 4.5 },
            "large_text_contrast_ratio": { "const": 3 },
            "non_text_contrast_ratio": { "const": 3 },
            "viewport_width_font_scaling": { "const": false },
            "text_spacing_override_required": { "const": true }
          }
        },
        "targets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minimum_level",
            "preference_level",
            "minimum_css_px",
            "preferred_touch_css_px",
            "preferred_gap_css_px",
            "exceptions_require_evidence"
          ],
          "properties": {
            "minimum_level": { "const": "hard_floor" },
            "preference_level": { "const": "product_default" },
            "minimum_css_px": {
              "type": "integer",
              "minimum": 24,
              "maximum": 44
            },
            "preferred_touch_css_px": {
              "type": "integer",
              "minimum": 44,
              "maximum": 48
            },
            "preferred_gap_css_px": {
              "type": "integer",
              "minimum": 0,
              "maximum": 16
            },
            "exceptions_require_evidence": { "const": true }
          }
        },
        "responsive": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "level",
            "required_viewports_px",
            "page_horizontal_overflow_allowed",
            "local_overflow_roles",
            "local_overflow_requirements"
          ],
          "properties": {
            "level": { "const": "hard_floor" },
            "required_viewports_px": { "const": [1440, 390, 320] },
            "page_horizontal_overflow_allowed": { "const": false },
            "local_overflow_roles": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "data-table",
                  "diagram",
                  "map",
                  "media",
                  "persistent-toolbar"
                ]
              }
            },
            "local_overflow_requirements": {
              "const": [
                "bounded-region",
                "accessible-name",
                "visible-cue",
                "keyboard-access"
              ]
            }
          }
        },
        "focus": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "visible_level",
            "enhanced_level",
            "visible_required",
            "enhanced_indicator_css_px",
            "enhanced_contrast_ratio",
            "geometry_matches_control"
          ],
          "properties": {
            "visible_level": { "const": "hard_floor" },
            "enhanced_level": { "const": "product_default" },
            "visible_required": { "const": true },
            "enhanced_indicator_css_px": {
              "type": "integer",
              "minimum": 2,
              "maximum": 4
            },
            "enhanced_contrast_ratio": {
              "type": "number",
              "minimum": 3
            },
            "geometry_matches_control": { "const": true }
          }
        },
        "dialog": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "semantic_level",
            "pattern_level",
            "semantic_requirements",
            "pattern_behaviors"
          ],
          "properties": {
            "semantic_level": { "const": "hard_floor" },
            "pattern_level": { "const": "product_default" },
            "semantic_requirements": {
              "const": [
                "accessible-name",
                "modal-state-truthful"
              ]
            },
            "pattern_behaviors": {
              "const": [
                "focus-entry",
                "focus-trap",
                "background-inert",
                "escape-or-explicit-exception",
                "focus-return"
              ]
            }
          }
        },
        "table": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "required_behaviors"],
          "properties": {
            "level": { "const": "hard_floor" },
            "required_behaviors": {
              "const": [
                "semantic-table-or-named-record-list",
                "header-association",
                "keyboard-action-semantics",
                "no-silent-column-loss"
              ]
            }
          }
        },
        "icons": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "level",
            "one_family",
            "character_glyphs_allowed",
            "icon_only_policy",
            "fallback"
          ],
          "properties": {
            "level": { "const": "product_default" },
            "one_family": { "const": true },
            "character_glyphs_allowed": { "const": false },
            "icon_only_policy": { "type": "string", "minLength": 1 },
            "fallback": { "type": "string", "minLength": 1 }
          }
        },
        "feedback": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "semantic_level",
            "recovery_level",
            "status_programmatically_determinable",
            "input_error_text_required",
            "color_only_meaning_allowed",
            "preserve_recoverable_input",
            "critical_toast_only",
            "recovery_action_adjacent",
            "state_policy"
          ],
          "properties": {
            "semantic_level": { "const": "hard_floor" },
            "recovery_level": { "const": "product_default" },
            "status_programmatically_determinable": { "const": true },
            "input_error_text_required": { "const": true },
            "color_only_meaning_allowed": { "const": false },
            "preserve_recoverable_input": { "const": true },
            "critical_toast_only": { "const": false },
            "recovery_action_adjacent": { "const": true },
            "state_policy": { "type": "string", "minLength": 1 }
          }
        },
        "form_assistance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "presented_semantics_level",
            "input_purpose_level",
            "redundant_entry_level",
            "native_association_level"
          ],
          "properties": {
            "presented_semantics_level": { "const": "hard_floor" },
            "input_purpose_level": { "const": "hard_floor" },
            "redundant_entry_level": { "const": "hard_floor" },
            "native_association_level": { "const": "product_default" }
          }
        },
        "accessible_authentication": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minimum_level",
            "complete_path_required",
            "permitted_conformance_routes",
            "whole_value_paste_when_used_as_assistance"
          ],
          "properties": {
            "minimum_level": { "const": "hard_floor" },
            "complete_path_required": { "const": true },
            "permitted_conformance_routes": {
              "const": [
                "alternative-without-cognitive-function-test",
                "completion-assistance",
                "level-aa-exception"
              ]
            },
            "whole_value_paste_when_used_as_assistance": { "const": true }
          }
        },
        "transient_interaction_and_time": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hover_focus_level",
            "focus_not_entirely_obscured_level",
            "full_focus_visibility_level",
            "timing_adjustable_level",
            "pause_stop_hide_level",
            "interaction_motion_level",
            "time_limit_adjustment_min_multiplier",
            "time_limit_extension_warning_min_seconds",
            "time_limit_extension_min_repetitions",
            "moving_content_control_threshold_seconds",
            "long_time_limit_exception_threshold_hours"
          ],
          "properties": {
            "hover_focus_level": { "const": "hard_floor" },
            "focus_not_entirely_obscured_level": { "const": "hard_floor" },
            "full_focus_visibility_level": { "const": "product_default" },
            "timing_adjustable_level": { "const": "hard_floor" },
            "pause_stop_hide_level": { "const": "hard_floor" },
            "interaction_motion_level": { "const": "product_default" },
            "time_limit_adjustment_min_multiplier": { "const": 10 },
            "time_limit_extension_warning_min_seconds": { "const": 20 },
            "time_limit_extension_min_repetitions": { "const": 10 },
            "moving_content_control_threshold_seconds": { "const": 5 },
            "long_time_limit_exception_threshold_hours": { "const": 20 }
          }
        },
        "repeated_context_consistency": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "help_order_level",
            "navigation_order_level",
            "identification_level",
            "stable_help_placement_level",
            "page_set_declaration_required"
          ],
          "properties": {
            "help_order_level": { "const": "hard_floor" },
            "navigation_order_level": { "const": "hard_floor" },
            "identification_level": { "const": "hard_floor" },
            "stable_help_placement_level": { "const": "product_default" },
            "page_set_declaration_required": { "const": true }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["schema_version"],
            "properties": {
              "schema_version": { "const": "web-interface-policy/v1" }
            }
          },
          "then": {
            "properties": {
              "form_assistance": false,
              "accessible_authentication": false,
              "transient_interaction_and_time": false,
              "repeated_context_consistency": false
            }
          }
        },
        {
          "if": {
            "required": ["schema_version"],
            "properties": {
              "schema_version": { "const": "web-interface-policy/v2" }
            }
          },
          "then": {
            "required": [
              "form_assistance",
              "accessible_authentication",
              "transient_interaction_and_time",
              "repeated_context_consistency"
            ]
          }
        }
      ]
    },
    "product_preset_id": { "type": "string", "minLength": 1 },
    "surface_id": { "enum": ["ppt", "html", "poster", "dashboard"] },
    "topology_id": {
      "enum": [
        "comparison-matrix",
        "timeline",
        "causal-chain",
        "system-map",
        "metric-evidence",
        "decision-frame",
        "narrative-arc"
      ]
    },
    "style_preset_id": {
      "enum": [
        "neutral-analytic",
        "editorial-report",
        "swiss-deck",
        "magazine-deck",
        "operational-dashboard",
        "tweakable-lab"
      ]
    },
    "content_constraint_target": {
      "enum": [
        "content.required_fields",
        "content.required_facts",
        "content.semantic_order",
        "content.density_bounds",
        "content.evidence_role",
        "content.primary_action",
        "content.do_not_rewrite",
        "content.preserved_invariants"
      ]
    },
    "content_constraint_source": {
      "enum": [
        "required_fields",
        "required_facts",
        "semantic_order",
        "density_bounds",
        "evidence_role",
        "primary_action",
        "do_not_rewrite",
        "preserved_invariants"
      ]
    },
    "non_empty_strings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "routing_condition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reader_jobs": { "$ref": "#/$defs/non_empty_strings" },
        "content_roles": { "$ref": "#/$defs/non_empty_strings" },
        "evidence_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["none", "supporting", "primary"] }
        },
        "requires_reduced_transparency": { "type": "boolean" }
      }
    },
    "content_routing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_signal_paths",
        "constraints",
        "rules",
        "visual_conflict_policies",
        "degradation_rules"
      ],
      "properties": {
        "required_signal_paths": {
          "const": [
            "content_role",
            "required_fields",
            "required_facts",
            "semantic_order",
            "density_bounds",
            "evidence_role",
            "primary_action",
            "do_not_rewrite",
            "preserved_invariants",
            "truth_status",
            "delivery.source_medium",
            "delivery.target_medium",
            "delivery.reduced_motion"
          ]
        },
        "constraints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "target_path", "source_path"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "target_path": { "$ref": "#/$defs/content_constraint_target" },
              "source_path": { "$ref": "#/$defs/content_constraint_source" }
            }
          }
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "when", "profile_id", "reason_code", "enforced_constraint_ids"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "when": {
                "type": "object",
                "additionalProperties": false,
                "required": ["reader_jobs", "content_roles"],
                "properties": {
                  "reader_jobs": { "$ref": "#/$defs/non_empty_strings" },
                  "content_roles": { "$ref": "#/$defs/non_empty_strings" }
                }
              },
              "profile_id": { "$ref": "#/$defs/product_preset_id" },
              "reason_code": { "type": "string", "minLength": 1 },
              "enforced_constraint_ids": { "$ref": "#/$defs/non_empty_strings" }
            }
          }
        },
        "visual_conflict_policies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "when", "disallowed_visual_profile_ids", "reason_code"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "when": { "$ref": "#/$defs/routing_condition" },
              "disallowed_visual_profile_ids": { "$ref": "#/$defs/non_empty_strings" },
              "reason_code": { "type": "string", "minLength": 1 }
            }
          }
        },
        "degradation_rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id", "source_mediums", "target_mediums", "preserved_invariants",
              "removed_mechanisms", "substitute_representation", "status"
            ],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "source_mediums": {
                "type": "array", "minItems": 1, "uniqueItems": true,
                "items": { "enum": ["interactive-web", "dynamic", "wide-screen"] }
              },
              "target_mediums": {
                "type": "array", "minItems": 1, "uniqueItems": true,
                "items": { "enum": ["static-document", "ppt", "print", "reduced-motion", "narrow-screen"] }
              },
              "preserved_invariants": {
                "type": "array", "minItems": 5, "uniqueItems": true,
                "items": { "enum": ["facts", "hierarchy", "reading_order", "state_meaning", "action_intent"] }
              },
              "removed_mechanisms": { "$ref": "#/$defs/non_empty_strings" },
              "substitute_representation": { "$ref": "#/$defs/non_empty_strings" },
              "status": { "const": "degraded_to_static" }
            }
          }
        }
      }
    },
    "product_preset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "aesthetic_thesis",
        "tone",
        "style_preset_by_surface",
        "typography_direction",
        "color_direction",
        "composition",
        "media",
        "data_visualization",
        "motion",
        "surface_emphasis",
        "anti_patterns"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/product_preset_id" },
        "aesthetic_thesis": { "type": "string", "minLength": 1 },
        "tone": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "style_preset_by_surface": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ppt", "html", "poster", "dashboard"],
          "properties": {
            "ppt": { "$ref": "#/$defs/style_preset_id" },
            "html": { "$ref": "#/$defs/style_preset_id" },
            "poster": { "$ref": "#/$defs/style_preset_id" },
            "dashboard": { "$ref": "#/$defs/style_preset_id" }
          }
        },
        "typography_direction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["display_role", "body_role", "numeric_role"],
          "properties": {
            "display_role": { "type": "string", "minLength": 1 },
            "body_role": { "type": "string", "minLength": 1 },
            "numeric_role": { "type": "string", "minLength": 1 }
          }
        },
        "color_direction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "focal_job",
            "semantic_exceptions",
            "media_integration",
            "avoid"
          ],
          "properties": {
            "focal_job": { "type": "string", "minLength": 1 },
            "semantic_exceptions": { "type": "string", "minLength": 1 },
            "media_integration": { "type": "string", "minLength": 1 },
            "avoid": { "type": "string", "minLength": 1 }
          }
        },
        "composition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "grid",
            "density",
            "primary_focus",
            "max_radius_px",
            "edge_tolerance_px",
            "control_heights_px",
            "alignment_policy"
          ],
          "properties": {
            "grid": { "type": "string", "minLength": 1 },
            "density": { "enum": ["dense", "normal", "roomy"] },
            "primary_focus": { "type": "string", "minLength": 1 },
            "max_radius_px": { "type": "integer", "minimum": 0, "maximum": 8 },
            "edge_tolerance_px": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            },
            "control_heights_px": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 28,
                "maximum": 48
              }
            },
            "alignment_policy": { "type": "string", "minLength": 1 }
          }
        },
        "media": {
          "type": "object",
          "additionalProperties": false,
          "required": ["priority", "icon_policy"],
          "properties": {
            "priority": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "icon_policy": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "family",
                "source",
                "sizes_px",
                "box_px",
                "text_gap_px",
                "icon_only",
                "fallback"
              ],
              "properties": {
                "family": { "type": "string", "minLength": 1 },
                "source": { "type": "string", "minLength": 1 },
                "sizes_px": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 3,
                  "uniqueItems": true,
                  "items": {
                    "type": "integer",
                    "minimum": 12,
                    "maximum": 24
                  }
                },
                "box_px": {
                  "type": "integer",
                  "minimum": 16,
                  "maximum": 32
                },
                "text_gap_px": {
                  "type": "integer",
                  "minimum": 4,
                  "maximum": 12
                },
                "icon_only": { "type": "string", "minLength": 1 },
                "fallback": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "data_visualization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["default", "avoid"],
          "properties": {
            "default": { "type": "string", "minLength": 1 },
            "avoid": { "type": "string", "minLength": 1 }
          }
        },
        "motion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["default", "max_duration_ms"],
          "properties": {
            "default": {
              "enum": ["static", "semantic_only", "restrained_brand"]
            },
            "max_duration_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 600
            }
          }
        },
        "surface_emphasis": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ppt", "html", "poster", "dashboard"],
          "properties": {
            "ppt": { "type": "string", "minLength": 1 },
            "html": { "type": "string", "minLength": 1 },
            "poster": { "type": "string", "minLength": 1 },
            "dashboard": { "type": "string", "minLength": 1 }
          }
        },
        "anti_patterns": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "surface_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "artifact_type",
        "canvas",
        "grid",
        "safe_area",
        "minimum_body_size",
        "max_primary_claims",
        "interaction_policy",
        "delivery_mode",
        "required_checks"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/surface_id" },
        "artifact_type": {
          "enum": ["ppt-handoff", "html-deck", "poster", "dashboard"]
        },
        "canvas": { "type": "string", "minLength": 1 },
        "grid": { "type": "string", "minLength": 1 },
        "safe_area": { "type": "string", "minLength": 1 },
        "minimum_body_size": { "type": "string", "minLength": 1 },
        "max_primary_claims": { "type": "integer", "minimum": 1, "maximum": 1 },
        "interaction_policy": { "type": "string", "minLength": 1 },
        "delivery_mode": {
          "enum": ["handoff_only", "responsive_document", "fixed_canvas"]
        },
        "required_checks": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "locale_policy": { "$ref": "#/$defs/locale_policy" }
      },
      "allOf": [
        {
          "if": {
            "required": ["id"],
            "properties": { "id": { "const": "dashboard" } }
          },
          "then": { "required": ["locale_policy"] }
        }
      ]
    },
    "locale_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locale",
        "exempt_categories",
        "visible_text_violation_limit",
        "accessible_name_violation_limit"
      ],
      "properties": {
        "locale": { "const": "zh-CN" },
        "exempt_categories": {
          "const": [
            "brand",
            "technical_id",
            "source_field",
            "approved_abbreviation"
          ]
        },
        "visible_text_violation_limit": { "const": 0 },
        "accessible_name_violation_limit": { "const": 0 }
      }
    },
    "topology_pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "relationship",
        "reader_job",
        "composition",
        "required_evidence",
        "avoid_when"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/topology_id" },
        "relationship": {
          "enum": [
            "comparison",
            "chronology",
            "causality",
            "system",
            "metrics",
            "decision",
            "narrative"
          ]
        },
        "reader_job": { "type": "string", "minLength": 1 },
        "composition": { "type": "string", "minLength": 1 },
        "required_evidence": { "type": "string", "minLength": 1 },
        "avoid_when": { "type": "string", "minLength": 1 }
      }
    }
  }
}
