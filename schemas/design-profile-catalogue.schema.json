{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Design Profile Catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product_presets",
    "surface_contracts",
    "topology_patterns",
    "routing"
  ],
  "properties": {
    "schema_version": { "const": "design-profile-catalogue/v1" },
    "product_presets": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/product_preset" }
    },
    "surface_contracts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/surface_contract" }
    },
    "topology_patterns": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "$ref": "#/$defs/topology_pattern" }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reader_job_to_preset",
        "relationship_to_topology",
        "relationship_to_secondary_preset",
        "secondary_inheritance_fields"
      ],
      "properties": {
        "reader_job_to_preset": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/product_preset_id" }
        },
        "relationship_to_topology": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/topology_id" }
        },
        "relationship_to_secondary_preset": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/product_preset_id" }
        },
        "secondary_inheritance_fields": {
          "const": ["topology", "surface_emphasis"]
        }
      }
    }
  },
  "$defs": {
    "product_preset_id": {
      "enum": [
        "executive-strategy",
        "enterprise-saas",
        "data-analytics",
        "technical-architecture",
        "consumer-brand",
        "editorial-research"
      ]
    },
    "surface_id": { "enum": ["ppt", "html", "poster"] },
    "topology_id": {
      "enum": [
        "comparison-matrix",
        "timeline",
        "causal-chain",
        "system-map",
        "metric-evidence",
        "decision-frame",
        "narrative-arc"
      ]
    },
    "style_preset_id": {
      "enum": [
        "neutral-analytic",
        "editorial-report",
        "swiss-deck",
        "magazine-deck",
        "operational-dashboard",
        "tweakable-lab"
      ]
    },
    "product_preset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "aesthetic_thesis",
        "tone",
        "style_preset_by_surface",
        "typography_direction",
        "composition",
        "media",
        "data_visualization",
        "motion",
        "surface_emphasis",
        "anti_patterns"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/product_preset_id" },
        "aesthetic_thesis": { "type": "string", "minLength": 1 },
        "tone": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "style_preset_by_surface": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ppt", "html", "poster"],
          "properties": {
            "ppt": { "$ref": "#/$defs/style_preset_id" },
            "html": { "$ref": "#/$defs/style_preset_id" },
            "poster": { "$ref": "#/$defs/style_preset_id" }
          }
        },
        "typography_direction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["display_role", "body_role", "numeric_role"],
          "properties": {
            "display_role": { "type": "string", "minLength": 1 },
            "body_role": { "type": "string", "minLength": 1 },
            "numeric_role": { "type": "string", "minLength": 1 }
          }
        },
        "composition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["grid", "density", "primary_focus", "max_radius_px"],
          "properties": {
            "grid": { "type": "string", "minLength": 1 },
            "density": { "enum": ["dense", "normal", "roomy"] },
            "primary_focus": { "type": "string", "minLength": 1 },
            "max_radius_px": { "type": "integer", "minimum": 0, "maximum": 8 }
          }
        },
        "media": {
          "type": "object",
          "additionalProperties": false,
          "required": ["priority", "icon_policy"],
          "properties": {
            "priority": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "icon_policy": { "type": "string", "minLength": 1 }
          }
        },
        "data_visualization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["default", "avoid"],
          "properties": {
            "default": { "type": "string", "minLength": 1 },
            "avoid": { "type": "string", "minLength": 1 }
          }
        },
        "motion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["default", "max_duration_ms"],
          "properties": {
            "default": {
              "enum": ["static", "semantic_only", "restrained_brand"]
            },
            "max_duration_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 600
            }
          }
        },
        "surface_emphasis": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ppt", "html", "poster"],
          "properties": {
            "ppt": { "type": "string", "minLength": 1 },
            "html": { "type": "string", "minLength": 1 },
            "poster": { "type": "string", "minLength": 1 }
          }
        },
        "anti_patterns": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "surface_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "artifact_type",
        "canvas",
        "grid",
        "safe_area",
        "minimum_body_size",
        "max_primary_claims",
        "interaction_policy",
        "delivery_mode",
        "required_checks"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/surface_id" },
        "artifact_type": {
          "enum": ["ppt-handoff", "html-deck", "poster"]
        },
        "canvas": { "type": "string", "minLength": 1 },
        "grid": { "type": "string", "minLength": 1 },
        "safe_area": { "type": "string", "minLength": 1 },
        "minimum_body_size": { "type": "string", "minLength": 1 },
        "max_primary_claims": { "type": "integer", "minimum": 1, "maximum": 1 },
        "interaction_policy": { "type": "string", "minLength": 1 },
        "delivery_mode": {
          "enum": ["handoff_only", "responsive_document", "fixed_canvas"]
        },
        "required_checks": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "topology_pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "relationship",
        "reader_job",
        "composition",
        "required_evidence",
        "avoid_when"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/topology_id" },
        "relationship": {
          "enum": [
            "comparison",
            "chronology",
            "causality",
            "system",
            "metrics",
            "decision",
            "narrative"
          ]
        },
        "reader_job": { "type": "string", "minLength": 1 },
        "composition": { "type": "string", "minLength": 1 },
        "required_evidence": { "type": "string", "minLength": 1 },
        "avoid_when": { "type": "string", "minLength": 1 }
      }
    }
  }
}
