{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Design Claim Map",
  "type": "object",
  "required": ["schema_version", "claims"],
  "properties": {
    "schema_version": { "const": "design-claim-map/v1" },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "text", "status", "source_refs"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "status": { "enum": ["verified", "assumption", "unverified"] },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "evidence_quotes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["source_ref", "quote"],
              "properties": {
                "source_ref": { "type": "string", "minLength": 1 },
                "quote": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "status": { "const": "verified" } },
              "required": ["status"]
            },
            "then": {
              "required": ["evidence_quotes"],
              "properties": {
                "evidence_quotes": { "minItems": 1 }
              }
            }
          }
        ]
      }
    }
  }
}
