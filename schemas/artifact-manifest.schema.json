{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Design Artifact Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "audience",
    "surface",
    "style_preset",
    "schematic",
    "source_materials",
    "data_sources",
    "metrics",
    "charts",
    "layouts",
    "assumptions",
    "missing_data",
    "unverified_items"
  ],
  "properties": {
    "schema_version": { "const": "design-artifact/v1" },
    "artifact_type": {
      "enum": ["data-report", "dashboard", "chart-frame", "html-deck", "ppt-handoff", "screenshot-evidence", "tweakable-artifact", "design-system", "multi-artifact"]
    },
    "audience": { "type": "string", "minLength": 1 },
    "surface": { "type": "string", "minLength": 1 },
    "style_preset": {
      "enum": ["neutral-analytic", "editorial-report", "swiss-deck", "magazine-deck", "operational-dashboard", "tweakable-lab"]
    },
    "schematic": { "type": "boolean" },
    "source_materials": { "type": "array" },
    "data_sources": { "type": "array" },
    "metrics": { "type": "array" },
    "charts": {
      "type": "array",
      "items": { "$ref": "#/$defs/chart" }
    },
    "visual_assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/visual_asset" }
    },
    "layouts": { "type": "array" },
    "assumptions": { "type": "array" },
    "missing_data": { "type": "array" },
    "unverified_items": { "type": "array" }
  },
  "$defs": {
    "chart": {
      "type": "object",
      "required": ["id", "family", "source", "unit", "question", "takeaway", "grain", "fields", "sample_size", "visual_encoding"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "family": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "unit": { "type": "string", "minLength": 1 },
        "question": { "type": "string", "minLength": 1 },
        "takeaway": { "type": "string", "minLength": 1 },
        "grain": { "type": "string", "minLength": 1 },
        "fields": { "type": "array", "minItems": 1 },
        "sample_size": { "type": "number", "minimum": 1 },
        "denominator": { "type": "string" },
        "visual_encoding": {
          "type": "object",
          "required": ["mark", "x", "y", "scale_type", "baseline", "domain", "label_policy"],
          "properties": {
            "mark": { "type": "string", "minLength": 1 },
            "x": { "type": "string", "minLength": 1 },
            "y": { "type": "string", "minLength": 1 },
            "scale_type": { "type": "string", "minLength": 1 },
            "baseline": { "type": "string", "minLength": 1 },
            "domain": { "type": "string", "minLength": 1 },
            "label_policy": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "visual_asset": {
      "type": "object",
      "required": ["id", "file", "slot"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "slide_id": { "type": "string", "minLength": 1 },
        "file": { "type": "string", "minLength": 1 },
        "slot": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "source": { "type": "string" },
        "kind": {
          "enum": ["image", "diagram", "flowchart", "mind-map", "screenshot", "icon-set", "data-block", "ui-scenario"]
        },
        "format": { "type": "string" },
        "schematic": { "type": "boolean" }
      }
    }
  }
}
