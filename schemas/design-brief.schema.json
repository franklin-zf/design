{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Design Brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reader_job",
    "primary_relationship",
    "secondary_relationships",
    "content_density",
    "brand_context"
  ],
  "properties": {
    "schema_version": { "const": "design-brief/v1" },
    "reader_job": {
      "enum": [
        "executive-decision",
        "operational-workflow",
        "analytical-evidence",
        "system-explanation",
        "brand-communication",
        "research-reading",
        "understand",
        "compare",
        "choose",
        "navigate",
        "input",
        "monitor",
        "inspect-evidence"
      ]
    },
    "primary_relationship": {
      "enum": [
        "comparison",
        "chronology",
        "causality",
        "system",
        "metrics",
        "decision",
        "narrative"
      ]
    },
    "secondary_relationships": {
      "type": "array",
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "comparison",
          "chronology",
          "causality",
          "system",
          "metrics",
          "decision",
          "narrative"
        ]
      }
    },
    "content_density": {
      "enum": ["auto", "dense", "normal", "roomy"]
    },
    "attention_context": {
      "enum": ["auto", "glance", "focused", "projected", "interrupted"]
    },
    "usage_frequency": {
      "enum": ["auto", "one-off", "repeated"]
    },
    "input_context": {
      "enum": ["auto", "keyboard", "pointer", "touch", "mixed", "none"]
    },
    "experience_mode": {
      "enum": ["operational", "editorial", "expressive", "immersive"]
    },
    "desired_impression": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "anti_impression": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "primary_subject": {
      "type": "string",
      "minLength": 1
    },
    "memory_target": {
      "type": "string",
      "minLength": 1
    },
    "reference_distance": {
      "enum": ["content-native", "method-only", "licensed-adaptation"]
    },
    "brand_context": {
      "enum": ["none", "provided"]
    },
    "content_signals": { "$ref": "#/$defs/content_signals" },
    "brand_ref": {
      "type": "string",
      "minLength": 1
    },
    "primary_preset_override": {
      "$ref": "#/$defs/product_preset_id"
    },
    "secondary_preset_override": {
      "$ref": "#/$defs/product_preset_id"
    },
    "secondary_preset_precedence": {
      "enum": ["primary-over-secondary"]
    },
    "override_reason": {
      "type": "string",
      "minLength": 1
    },
    "visual_treatment": { "$ref": "#/$defs/visual_treatment_request" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "brand_context": { "const": "provided" } },
        "required": ["brand_context"]
      },
      "then": { "required": ["brand_ref"] }
    },
    {
      "if": {
        "anyOf": [
          { "required": ["primary_preset_override"] },
          { "required": ["secondary_preset_override"] }
        ]
      },
      "then": { "required": ["override_reason"] }
    },
    {
      "if": { "required": ["secondary_preset_precedence"] },
      "then": { "required": ["secondary_preset_override"] }
    }
  ],
  "$defs": {
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "content_signals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "content_role": { "type": "string", "minLength": 1 },
        "required_fields": { "$ref": "#/$defs/non_empty_string_array" },
        "required_facts": { "$ref": "#/$defs/non_empty_string_array" },
        "semantic_order": { "$ref": "#/$defs/non_empty_string_array" },
        "density_bounds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min_items", "max_items"],
          "properties": {
            "min_items": { "type": "integer", "minimum": 0 },
            "max_items": { "type": "integer", "minimum": 1 }
          }
        },
        "evidence_role": { "enum": ["none", "supporting", "primary"] },
        "primary_action": {
          "type": "object",
          "additionalProperties": false,
          "required": ["intent", "required"],
          "properties": {
            "intent": { "type": "string", "minLength": 1 },
            "required": { "type": "boolean" }
          }
        },
        "do_not_rewrite": { "$ref": "#/$defs/non_empty_string_array" },
        "preserved_invariants": { "$ref": "#/$defs/non_empty_string_array" },
        "truth_status": { "enum": ["verified", "partial", "unknown", "conflict"] },
        "accessibility": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requires_reduced_transparency": { "type": "boolean" }
          }
        },
        "delivery": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source_medium": { "type": "string", "minLength": 1 },
            "target_medium": { "type": "string", "minLength": 1 },
            "reduced_motion": { "type": "boolean" }
          }
        },
        "candidate_signals": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "categories": { "$ref": "#/$defs/non_empty_string_array" },
            "styles": { "$ref": "#/$defs/non_empty_string_array" },
            "templates": { "$ref": "#/$defs/non_empty_string_array" }
          }
        }
      }
    },
    "provenance": {
      "enum": [
        "source-verbatim",
        "accessibility-policy",
        "content-constraint",
        "profile-explicit",
        "suggested-default"
      ]
    },
    "recipe_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "provenance"],
      "properties": {
        "value": {},
        "unit": { "type": "string", "minLength": 1 },
        "provenance": { "$ref": "#/$defs/provenance" }
      },
      "allOf": [
        {
          "if": { "properties": { "value": { "type": "number" } }, "required": ["value"] },
          "then": { "required": ["unit"] }
        }
      ]
    },
    "visual_treatment_request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile_id": { "type": "string", "minLength": 1 },
        "variation_id": { "type": "string", "minLength": 1 },
        "cues": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "recipe_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "backdrop_filter": { "type": "boolean" } }
        },
        "background_complexity": { "enum": ["low", "moderate", "high", "unknown"] },
        "overrides": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/recipe_input" }
        }
      },
      "anyOf": [
        { "required": ["profile_id"] },
        { "required": ["cues"] }
      ]
    },
    "product_preset_id": { "type": "string", "minLength": 1 }
  }
}
