{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/design/inspiration-binding.schema.json",
  "title": "Design inspiration binding v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "status",
    "trigger_reason",
    "execution_plan_digest",
    "library",
    "selected_references"
  ],
  "properties": {
    "schema_version": {
      "const": "design-inspiration-binding/v1"
    },
    "artifact_type": {
      "enum": [
        "data-report",
        "dashboard",
        "chart-frame",
        "html-deck",
        "ppt-handoff",
        "poster",
        "screenshot-evidence",
        "tweakable-artifact",
        "design-system",
        "multi-artifact"
      ]
    },
    "status": {
      "enum": ["applied", "skipped"]
    },
    "trigger_reason": {
      "type": "string",
      "minLength": 8
    },
    "skip_reason": {
      "type": "string",
      "minLength": 8
    },
    "execution_plan_digest": {
      "$ref": "#/$defs/sha256"
    },
    "library": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "server",
        "server_version",
        "library_version"
      ],
      "properties": {
        "server": {
          "const": "dribbble-hub-mcp"
        },
        "server_version": {
          "const": "1.0.0"
        },
        "library_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "selected_references": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/reference"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["status"],
        "properties": {
          "status": { "const": "applied" }
        }
      },
      "then": {
        "properties": {
          "selected_references": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "required": ["status"],
        "properties": {
          "status": { "const": "skipped" }
        }
      },
      "then": {
        "required": ["skip_reason"],
        "properties": {
          "selected_references": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "source_url",
        "preview_source_url",
        "preview_sha256",
        "extracted_methods",
        "do_not_copy",
        "rights"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "content_topology",
            "visual_language",
            "media_strategy",
            "interaction"
          ]
        },
        "source_url": {
          "type": "string",
          "pattern": "^https://dribbble\\.com/shots/"
        },
        "preview_source_url": {
          "type": "string",
          "pattern": "^https://cdn\\.dribbble\\.com/userupload/"
        },
        "preview_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "extracted_methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 8
          }
        },
        "do_not_copy": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "rights": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "usage",
            "license_status",
            "distribution",
            "direct_reuse_allowed",
            "attribution"
          ],
          "properties": {
            "usage": {
              "const": "internal-visual-reference-only"
            },
            "license_status": {
              "const": "unverified-internal-reference"
            },
            "distribution": {
              "const": "metadata-only"
            },
            "direct_reuse_allowed": {
              "const": false
            },
            "attribution": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
