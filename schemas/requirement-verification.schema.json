{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/design/requirement-verification.schema.json",
  "title": "Design requirement verification v1",
  "description": "Digest-bound product requirement coverage and acceptance evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_refs",
    "source_refs",
    "requirements",
    "coverage"
  ],
  "properties": {
    "schema_version": {
      "const": "design-requirement-verification/v1"
    },
    "artifact_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/file_ref"
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/file_ref"
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "p0_p1_total",
        "p0_p1_with_evidence",
        "p0_p1_passed",
        "status"
      ],
      "properties": {
        "p0_p1_total": {
          "type": "integer",
          "minimum": 0
        },
        "p0_p1_with_evidence": {
          "type": "integer",
          "minimum": 0
        },
        "p0_p1_passed": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "enum": [
            "complete",
            "incomplete"
          ]
        }
      }
    },
    "non_goals": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+"
    },
    "file_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "sha256"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/relative_path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "sha256",
        "kind"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/relative_path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "kind": {
          "enum": [
            "browser-test",
            "screenshot",
            "dom-binding",
            "content-binding",
            "accessibility-check",
            "performance-record",
            "delivery-check",
            "review-annotation"
          ]
        }
      }
    },
    "screenshot_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "sha256", "viewport", "state"],
      "properties": {
        "ref": { "$ref": "#/$defs/relative_path" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "viewport": { "enum": [1440, 390, 320] },
        "state": { "type": "string", "minLength": 1 }
      }
    },
    "evidence_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "plan",
        "render_spec",
        "render_profile",
        "screenshots"
      ],
      "properties": {
        "artifact": { "$ref": "#/$defs/file_ref" },
        "plan": { "$ref": "#/$defs/file_ref" },
        "render_spec": { "$ref": "#/$defs/file_ref" },
        "render_profile": { "$ref": "#/$defs/file_ref" },
        "screenshots": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/screenshot_binding" }
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "priority",
        "source_ref",
        "source_quote",
        "acceptance_criteria",
        "surface_states",
        "verification_method",
        "evidence_refs",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._-]{1,63}$"
        },
        "type": {
          "enum": [
            "functional",
            "content",
            "visual",
            "interaction",
            "responsive",
            "accessibility",
            "performance",
            "delivery"
          ]
        },
        "priority": {
          "enum": [
            "P0",
            "P1",
            "P2"
          ]
        },
        "source_ref": {
          "$ref": "#/$defs/relative_path"
        },
        "source_quote": {
          "type": "string",
          "minLength": 1
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "surface_states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "verification_method": {
          "enum": [
            "browser-test",
            "content-binding",
            "visual-review",
            "accessibility-audit",
            "performance-check",
            "delivery-check",
            "mixed"
          ]
        },
        "implementation_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relative_path"
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_ref"
          }
        },
        "evidence_binding": { "$ref": "#/$defs/evidence_binding" },
        "status": {
          "enum": [
            "passed",
            "failed",
            "blocked",
            "not_run",
            "not_applicable"
          ]
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "passed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "reviewer"
            ],
            "properties": {
              "evidence_refs": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "required": ["id"],
            "properties": {
              "id": {
                "enum": ["VIS-ALIGN", "VIS-LOCALE", "VIS-ICON", "VIS-COLOR"]
              }
            }
          },
          "then": {
            "required": ["evidence_binding"]
          }
        }
      ]
    }
  }
}
